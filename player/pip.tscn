code = "shader_type canvas_item;\nvoid fragment() {\n vec4 base = texture(TEXTURE, UV);\n float edge = 0.0;\n edge = max(edge, texture(TEXTURE, UV + vec2(TEXTURE_PIXEL_SIZE.x * 3.0, 0.0)).a);\n edge = max(edge, texture(TEXTURE, UV - vec2(TEXTURE_PIXEL_SIZE.x * 3.0, 0.0)).a);\n edge = max(edge, texture(TEXTURE, UV + vec2(0.0, TEXTURE_PIXEL_SIZE.y * 3.0)).a);\n edge = max(edge, texture(TEXTURE, UV - vec2(0.0, TEXTURE_PIXEL_SIZE.y * 3.0)).a);\n vec4 outline = vec4(0.25, 0.85, 1.0, edge * (1.0 - base.a));\n COLOR = mix(outline, vec4(base.rgb * 1.18, base.a), base.a);\n}"

